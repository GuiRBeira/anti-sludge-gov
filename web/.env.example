# Supabase — copie este arquivo para .env.local e preencha.
# Pegar em https://app.supabase.com/project/_/settings/api

# URL do projeto Supabase (ex: https://abcd1234.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable (também chamada "anon key" em projetos antigos).
# Segura para expor ao cliente.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave service_role — NUNCA expor ao cliente. Use só em scripts admin
# rodando no servidor. Opcional nesta fase.
SUPABASE_SERVICE_ROLE_KEY=


