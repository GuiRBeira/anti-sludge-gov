{
  "name": "anti-sludge-gov",
  "version": "1.0.0",
  "private": true,
  "description": "Anti-Sludge Gov Monorepo",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:web": "turbo dev --filter web",
    "build:web": "turbo build --filter web",
    "start:web": "pnpm --filter web start",
    "lint:web": "turbo lint --filter web",
    "dev:extension": "turbo dev --filter extension",
    "build:extension": "turbo build --filter extension",
    "dev:all": "turbo dev --filter web --filter extension",
    "clean": "pnpm -r exec rm -rf node_modules .next .plasmo && rm -rf node_modules",
    "postinstall": "bash scripts/patch-node-prefixes.sh",
    "release": "./scripts/release.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/api/**/*.py": [
      "apps/api/.venv/bin/ruff check --fix --exit-zero",
      "apps/api/.venv/bin/ruff format"
    ],
    "apps/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "keywords": [],
  "author": "GuiRBeira",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^12.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.4",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "semantic-release": "^25.0.3",
    "semantic-release-monorepo": "^8.0.2",
    "turbo": "^2.9.6",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19",
      "@types/react-dom": "^19"
    }
  },
  "dependencies": {
    "date-fns": "^4.1.0"
  }
}
