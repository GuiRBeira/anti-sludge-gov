{
  "name": "anti-sludge-gov",
  "version": "1.0.0",
  "private": true,
  "description": "Anti-Sludge Gov Monorepo",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "start:web": "pnpm --filter web start",
    "lint:web": "pnpm --filter web lint",
    "dev:extension": "pnpm --filter extension dev",
    "build:extension": "pnpm --filter extension build",
    "dev:all": "pnpm run dev:web & pnpm run dev:extension",
    "clean": "pnpm -r exec rm -rf node_modules .next .plasmo && rm -rf node_modules",
    "postinstall": "bash scripts/patch-node-prefixes.sh",
    "release": "./scripts/release.sh"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "keywords": [],
  "author": "GuiRBeira",
  "license": "MIT",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^12.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.4",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "jsdom": "^29.0.2",
    "semantic-release": "^25.0.3",
    "semantic-release-monorepo": "^8.0.2",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19",
      "@types/react-dom": "^19"
    }
  }
}
